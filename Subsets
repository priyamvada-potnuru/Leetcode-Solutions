class Solution {
public:
    vector<vector<int>> subsets(vector<int>& nums) {
        vector<vector<int>>sub;
        for(int i=0;i<=((1<<nums.size())-1);i++)
        {
            vector<int>pow;
            for(int j=0;j<=nums.size()-1;j++)
            {
                if(i&(1<<j))
                {
                    pow.push_back(nums[j]);
                }
            }
            sub.push_back(pow);
        }
        return sub;
    }
};
