class Solution {
public:
    int myAtoi(string s) {
        long long num=0;
        int si=0;
        int space=0;
        int level=0;
        char sign='+';
        for(int i=0;i<s.length();i++)
        {
            if(level==0)
            {
            if((s[i]=='-' || s[i]=='+') && si==0)
            {
                sign=s[i];
                si=1;
            }
            else if(s[i]==' ' && space==0)
            {
                space=1;
                continue;
            }
             else if(s[i]>='0' && s[i]<='9')
            {
                level++;
                num=s[i]-'0';
            }
            else if(s[i]!=' ')
            {
                return 0;
            }
            else if((s[i]=='-' || s[i]=='+') && si==1)
            {
                return 0;
            }
            else if(s[i]==' ' && si==1)
            {
                return 0;
            }
            }
            else if(s[i]>='0' && s[i]<='9')
            {
                    num=num*10+(s[i]-'0');
                    if(sign=='-' && -num<INT_MIN)
                    {
                        return INT_MIN;
                    }
                    else if(sign=='+' && num>INT_MAX)
                    {
                        return INT_MAX;
                    }
            }
            else
            {
                break;
            }
        }
        if(sign=='-')
        {
            return -num;
        }
        return num;
    }
};
