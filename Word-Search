class Solution {
public:
bool find(vector<vector<char>>&board,string word,int ind,int i,int j)
{
    if(ind==word.length())
    {
        return true;
    }
    if(i<0 || j<0 || i>board.size()-1 || j>board[0].size()-1 || board[i][j]!=word[ind])
    {
        return false;
    }
    char temp=board[i][j];
    board[i][j]='#';
    if(find(board,word,ind+1,i+1,j)==true) return true;
    if(find(board,word,ind+1,i-1,j)==true)return true;
    if(find(board,word,ind+1,i,j+1)==true)return true;
    if(find(board,word,ind+1,i,j-1)==true)return true;
    board[i][j]=temp;
    return false;
}
    bool exist(vector<vector<char>>& board, string word) {
        for(int i=0;i<board.size();i++)
        {
            for(int j=0;j<board[0].size();j++)
            {
                if(find(board,word,0,i,j)==true) return true;
            }
        }
        return false;
    }
};
