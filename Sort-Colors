class Solution {
public:
    void sortColors(vector<int>& nums) {
        int hash[3]={0};
        int index=0;
        for(int i=0;i<nums.size();i++)
        {
            hash[nums[i]]++;
        }
        for(int i=0;i<=2;i++)
        {
            int j=1;
            while(j<=hash[i])
            {
                    nums[index]=i;
                    index++;
                    j++;
            }
        }
    }
};
