class Solution {
public:
void find(int ind,vector<int>&nums,int n,vector<int>&ds,vector<vector<int>>&ans)
{
    ans.push_back(ds);
    for(int i=ind;i<n;i++)
    {
        if(i>ind && nums[i]==nums[i-1])continue;
             ds.push_back(nums[i]);
             find(i+1,nums,n,ds,ans);
             ds.pop_back();
    }
}
    vector<vector<int>> subsetsWithDup(vector<int>& nums) {
       sort(nums.begin(),nums.end());
       vector<int>ds;
        vector<vector<int>>ans;
        find(0,nums,nums.size(),ds,ans); 
        return ans;
    }
};
